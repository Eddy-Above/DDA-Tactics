{
  "name": "dda-tactics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node --import ./scripts/offline-env.mjs node_modules/nuxt/bin/nuxt.mjs build",
    "typecheck": "node --import ./scripts/offline-env.mjs node_modules/nuxt/bin/nuxt.mjs typecheck",
    "test": "node --import ./scripts/offline-env.mjs --test",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "start": "node .output/server/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@types/three": "^0.184.0",
    "@vueuse/core": "^11.0.0",
    "drizzle-orm": "0.45.4",
    "nuxt": "3.21.11",
    "nuxt-security": "2.7.0",
    "postgres": "^3.4.8",
    "three": "^0.184.0",
    "vue": "3.5.45",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@nuxt/schema": "3.21.11",
    "@nuxtjs/tailwindcss": "^6.12.0",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "typescript": "^5.5.0",
    "vue-tsc": "3.3.14"
  }
}
